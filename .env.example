# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_platform
DB_USER=postgres
DB_PASSWORD=your_password

# JWT (para futuros endpoints protegidos)
JWT_SECRET=your_super_secret_jwt_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Meta App Verification Token (para validar el webhook en Meta)
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# Nota: api_key_whatsapp y whatsapp_phone_id se almacenan por tenant en la BD
